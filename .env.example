CORTEX_ENVIRONMENT=development
CORTEX_DATABASE_URL=postgresql+asyncpg://cortex:cortex@127.0.0.1:5432/cortex
CORTEX_ENTERPRISE_ID=00000000-0000-0000-0000-000000000001
CORTEX_DEV_MODE=true
CORTEX_REQUIRED_ACCELERATOR=mps
CORTEX_OLLAMA_BASE_URL=http://127.0.0.1:11434
CORTEX_GENERATOR_MODEL=qwen3:14b
CORTEX_EMBEDDING_MODEL=qwen3-embedding:0.6b
CORTEX_OBJECT_STORAGE_ROOT=.cortex-data/object-storage
CORTEX_PIPELINE_VERSION=3
CORTEX_RETRIEVAL_CANDIDATE_LIMIT=120
CORTEX_RERANK_TOP_K=40
CORTEX_SOURCE_CONFIDENCE_THRESHOLD=0.58
CORTEX_MAX_UPLOAD_BYTES=52428800
CORTEX_SOURCE_FETCH_TIMEOUT_SECONDS=10.0
CORTEX_WEBSITE_ALLOWLIST='["127.0.0.1","localhost"]'
CORTEX_ALLOWED_UPLOAD_MIME_TYPES='["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/html","text/plain","text/markdown","text/csv"]'
CORTEX_WORKER_POLL_INTERVAL_SECONDS=1.0

# Split frontend packaging defaults for local/private development domains.
VITE_CORTEX_CONSOLE_PUBLIC_URL=https://cortex-console.hrudainirmal.in
VITE_CORTEX_QUERY_PUBLIC_URL=https://cortex-app.hrudainirmal.in
CORTEX_CONSOLE_HOST=cortex-console.hrudainirmal.in
CORTEX_QUERY_HOST=cortex-app.hrudainirmal.in
