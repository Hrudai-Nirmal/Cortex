CORTEX_ENVIRONMENT=development
CORTEX_DATABASE_URL=postgresql+asyncpg://cortex:cortex@127.0.0.1:5432/cortex
CORTEX_ENTERPRISE_ID=00000000-0000-0000-0000-000000000001
CORTEX_DEV_MODE=true
CORTEX_REQUIRED_ACCELERATOR=mps
CORTEX_OLLAMA_BASE_URL=http://127.0.0.1:11434
CORTEX_GENERATOR_MODEL=qwen3:14b
CORTEX_EMBEDDING_MODEL=qwen3-embedding:0.6b
CORTEX_OBJECT_STORAGE_ROOT=.cortex-data/object-storage
CORTEX_PIPELINE_VERSION=3
CORTEX_RETRIEVAL_CANDIDATE_LIMIT=120
CORTEX_RERANK_TOP_K=40
CORTEX_SOURCE_CONFIDENCE_THRESHOLD=0.58
CORTEX_WORKER_POLL_INTERVAL_SECONDS=1.0
