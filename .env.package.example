# Copy to .env.package before running the package scripts.

CORTEX_ENVIRONMENT=production
CORTEX_DEV_MODE=false
CORTEX_QUERY_SURFACE_MODE=bundled
CORTEX_EDGE_PORT=80

CORTEX_POSTGRES_DB=cortex
CORTEX_POSTGRES_USER=cortex
CORTEX_POSTGRES_PASSWORD=cortex
CORTEX_DATABASE_URL=postgresql+asyncpg://cortex:cortex@postgres:5432/cortex

CORTEX_OLLAMA_BASE_URL=http://ollama:11434
CORTEX_ALLOW_REMOTE_MODEL_ENDPOINT=false
# Pull these into Ollama after package boot if /health/ready reports missing models.
# The packaged local profile stays intentionally CPU-friendly for Docker Desktop verification.
CORTEX_GENERATOR_MODEL=qwen3:1.7b
CORTEX_EMBEDDING_MODEL=qwen3-embedding:0.6b
CORTEX_REQUIRED_ACCELERATOR=cpu
# Build-time PyTorch wheel source for Docling-backed package images.
# Keep the CPU wheel channel for packaged local verification. Override this to the matching
# PyTorch CUDA wheel index before rebuilding client images for intentional NVIDIA deployments.
CORTEX_PACKAGE_PYTORCH_WHEEL_INDEX_URL=https://download.pytorch.org/whl/cpu
CORTEX_PACKAGE_PYTORCH_PREINSTALL="torch torchvision"

CORTEX_OBJECT_STORAGE_ROOT=/var/lib/cortex/object-storage
# Evaluation default only. Replace with the client's real bearer/OIDC contract before production rollout.
CORTEX_AUTH_MODE=fixture

# Replace these documentation placeholders before running pnpm package:up.
# Production package URLs must stay rooted at the host: no extra path, query string, or fragment.
CORTEX_CONSOLE_HOST=cortex-console.example.com
CORTEX_QUERY_HOST=cortex-app.example.com
CORTEX_CONSOLE_PUBLIC_URL=https://cortex-console.example.com
CORTEX_QUERY_PUBLIC_URL=https://cortex-app.example.com
