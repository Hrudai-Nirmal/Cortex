# Copy to .env.package before running the package scripts.

CORTEX_EDGE_PORT=80

CORTEX_POSTGRES_DB=cortex
CORTEX_POSTGRES_USER=cortex
CORTEX_POSTGRES_PASSWORD=cortex
CORTEX_DATABASE_URL=postgresql+asyncpg://cortex:cortex@postgres:5432/cortex

CORTEX_OLLAMA_BASE_URL=http://ollama:11434
CORTEX_ALLOW_REMOTE_MODEL_ENDPOINT=false
# Pull these into Ollama after package boot if /health/ready reports missing models.
CORTEX_GENERATOR_MODEL=qwen3:14b
CORTEX_EMBEDDING_MODEL=qwen3-embedding:0.6b
CORTEX_REQUIRED_ACCELERATOR=cpu

CORTEX_OBJECT_STORAGE_ROOT=/var/lib/cortex/object-storage
CORTEX_AUTH_MODE=fixture

CORTEX_CONSOLE_HOST=cortex-console.example.com
CORTEX_QUERY_HOST=cortex-app.example.com
CORTEX_CONSOLE_PUBLIC_URL=https://cortex-console.example.com
CORTEX_QUERY_PUBLIC_URL=https://cortex-app.example.com
