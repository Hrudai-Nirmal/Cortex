# Build and serve the dedicated Cortex console frontend image.

FROM node:22-alpine AS builder
WORKDIR /workspace

ARG VITE_CORTEX_CONSOLE_PUBLIC_URL=https://cortex-console.hrudainirmal.in
ARG VITE_CORTEX_QUERY_PUBLIC_URL=https://cortex-app.hrudainirmal.in
ENV VITE_CORTEX_CONSOLE_PUBLIC_URL=$VITE_CORTEX_CONSOLE_PUBLIC_URL
ENV VITE_CORTEX_QUERY_PUBLIC_URL=$VITE_CORTEX_QUERY_PUBLIC_URL

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN corepack enable && pnpm install --frozen-lockfile

COPY apps/web apps/web
RUN pnpm --dir apps/web build:console

FROM nginx:1.27-alpine
COPY apps/web/nginx.static.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/web/dist-console /usr/share/nginx/html
EXPOSE 8080
