# Build and serve the dedicated Cortex query-app frontend image.

FROM node:22-alpine AS builder
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN corepack enable && pnpm install --frozen-lockfile

COPY apps/web apps/web
RUN pnpm --dir apps/web build:query

FROM nginx:1.27-alpine
COPY apps/web/nginx.static.conf /etc/nginx/conf.d/default.conf
COPY apps/web/docker-entrypoint.d/40-cortex-runtime-config.sh /docker-entrypoint.d/40-cortex-runtime-config.sh
COPY --from=builder /workspace/apps/web/dist-query /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.d/40-cortex-runtime-config.sh
EXPOSE 8080
