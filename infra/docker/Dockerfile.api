# Build the Cortex API image for client-managed infrastructure.

FROM python:3.12-slim
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml README.md alembic.ini ./
COPY apps/api apps/api
COPY migrations migrations

RUN pip install --no-cache-dir -e '.[dev,ingestion]'

EXPOSE 8000
CMD ["uvicorn", "cortex.main:createApp", "--factory", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000"]
