# Build the Cortex worker image for durable ingestion and retention jobs.

FROM python:3.12-slim
WORKDIR /app

ARG CORTEX_PACKAGE_PYTORCH_WHEEL_INDEX_URL="https://download.pytorch.org/whl/cpu"
ARG CORTEX_PACKAGE_PYTORCH_PREINSTALL="torch torchvision"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CORTEX_PACKAGE_PYTORCH_WHEEL_INDEX_URL=${CORTEX_PACKAGE_PYTORCH_WHEEL_INDEX_URL} \
    CORTEX_PACKAGE_PYTORCH_PREINSTALL=${CORTEX_PACKAGE_PYTORCH_PREINSTALL}

COPY pyproject.toml README.md alembic.ini ./
COPY apps/api apps/api
COPY migrations migrations
COPY infra/docker/install-python-package.sh /usr/local/bin/install-python-package

RUN chmod +x /usr/local/bin/install-python-package
RUN /usr/local/bin/install-python-package '.[dev,ingestion]'

CMD ["python", "-m", "cortex.worker"]
