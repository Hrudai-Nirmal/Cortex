# Route the fixed Cortex console plus API-only employee host when query-web is client-owned.

upstream cortex_api {
  server api:8000;
}

upstream cortex_console {
  server console-web:8080;
}

server {
  listen 8080;
  server_name ${CORTEX_CONSOLE_HOST};
  add_header X-Cortex-Surface console always;

  location /v1/ {
    proxy_pass http://cortex_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 30s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }

  location /health/ {
    proxy_pass http://cortex_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://cortex_console;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 8080;
  server_name ${CORTEX_QUERY_HOST};
  add_header X-Cortex-Surface query always;

  location /v1/ {
    proxy_pass http://cortex_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 30s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }

  location /health/ {
    proxy_pass http://cortex_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    return 404;
  }
}

server {
  listen 8080 default_server;
  server_name _;
  return 404;
}
